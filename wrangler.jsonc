{
  "name": "d1-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "D1_STORE" }
  ],
  "observability": { "enabled": true }
}
